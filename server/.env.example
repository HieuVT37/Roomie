PORT=5000
MONGO_URI=mongodb://localhost:27017/roomie
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PAYMENT_MODE=mock

# Gửi email OTP (miễn phí). MAIL_PROVIDER = gmail | brevo | console
#   gmail:  GMAIL_USER + GMAIL_APP_PASSWORD (Mật khẩu ứng dụng 16 ký tự của Google)
#   brevo:  BREVO_API_KEY + MAIL_FROM (địa chỉ người gửi đã xác minh trên Brevo) — dùng khi deploy Render
#   console: không gửi thật, in mã ra terminal (chỉ khi phát triển)
MAIL_PROVIDER=console
MAIL_FROM_NAME=Roomie
GMAIL_USER=
GMAIL_APP_PASSWORD=
BREVO_API_KEY=
MAIL_FROM=

# Trợ lý Roomie AI (Gemini). GEMINI_MODEL mặc định gemini-3.5-flash-lite (miễn phí, nhanh)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
